# Shree Sudhakar Group - Supabase & Server Configuration
# Get your credentials from https://supabase.com/dashboard -> Project Settings -> API

# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon public key (or service_role key for backend operations)
SUPABASE_KEY=your-anon-or-service-role-key-here

# Local Server Port (default 8000)
PORT=8000
